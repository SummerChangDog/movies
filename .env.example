# ────────────────────────────────────────────
#  环境变量配置示例 — 复制为 .env 并填入真实值
#  也可直接运行 python run.py，程序会交互式提示输入
# ────────────────────────────────────────────

# OMDb API 密钥（提供 IMDb / 烂番茄评分）
# 申请地址：http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-api-key-here

# 大模型 API 配置（用于电影名称中英互译）
# 支持 OpenAI 及兼容格式的第三方服务
LLM_API_KEY=your-llm-api-key-here
LLM_API_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# 豆瓣 API 密钥（暂不需要，留空即可）
DOUBAN_API_KEY=

# Flask 应用配置
SECRET_KEY=your-secret-key-here
DEBUG=True
HOST=0.0.0.0
PORT=5000
